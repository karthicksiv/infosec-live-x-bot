# Copy this file to .env and fill in the four keys. Do not share .env.
# The keys come from the X Developer Console (console.x.com), from an app with
# "Read and write" permission. Make the access token while you are signed in
# as the bot account.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# The longest reply. 4000 puts AFFECTED and ACTION in one reply.
# This needs X Premium (any tier) on the bot account, because the reply is
# longer than 280 characters. Without Premium, set 280 and the bot splits the
# reply. The main post always stays within 280.
MAX_REPLY_CHARS=4000

# The most alerts that one run can post. This limits the cost if the feed misbehaves.
MAX_ALERTS_PER_RUN=3
