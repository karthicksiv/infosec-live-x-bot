# Copy this file to .env and add the key. Do not share .env.
# The key is on https://ifttt.com/maker_webhooks > Documentation.
IFTTT_WEBHOOK_KEY=

# The event name of the IFTTT Applet's "Receive a web request" trigger.
IFTTT_EVENT=infosec_alert

# The most alerts that one run can send. This limits the damage if the feed misbehaves.
MAX_ALERTS_PER_RUN=3
